def read_png(path):
    """Width, height and raw scanlines of a PNG as the simulator writes it (8-bit RGB)."""
    with open(path, "rb") as handle:
        data = handle.read()
    position, header, packed = 8, None, b""
    while position < len(data):
        length, kind = struct.unpack(">I4s", data[position:position + 8])
        body = data[position + 8:position + 8 + length]
        if kind == b"IHDR":
            header = body
        elif kind == b"IDAT":
            packed += body
        position += 12 + length
    width, height = struct.unpack(">II", header[:8])
    return width, height, header, zlib.decompress(packed)


def write_png(path, header, raw):
    def chunk(kind, body):
        return struct.pack(">I", len(body)) + kind + body + struct.pack(">I", zlib.crc32(kind + body))

    with open(path, "wb") as handle:
        handle.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", header) + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))


def main():
    names = sys.argv[1:]
    if any(name.startswith("-") for name in names):
        print(__doc__.strip())
        return 0
    if not names:
        names = sorted(name[:-4] for name in os.listdir(PLUGINS) if name.endswith(".lua"))
    os.makedirs(SHOTS, exist_ok=True)
    failed = []
    with tempfile.TemporaryDirectory() as scratch:
        for name in names:
            source = os.path.join(PLUGINS, name + ".lua")
            if not os.path.exists(source):
                print("%-14s there is no plugins/%s.lua" % (name, name))
                failed.append(name)
                continue
            recipe = RECIPES.get(name, "").format(replies=REPLIES, fixtures=FIXTURES, when=WHEN)
            large = os.path.join(scratch, name + ".png")
            command = [os.path.join(ROOT, "tools", "sim", "run.sh"), source, "--scale", "2", "--out", large] + shlex.split(recipe)
            result = subprocess.run(command, capture_output=True, text=True)
            if result.returncode != 0 or not os.path.exists(large):
                print("%-14s failed:\n%s" % (name, (result.stdout + result.stderr).strip()))
                failed.append(name)
                continue
            width, height, header, raw = read_png(large)
            target = os.path.join(SHOTS, name + ".png")
            write_png(target, header, raw)
            print("%-14s %dx%d, %.1f KB" % (name, width, height, os.path.getsize(target) / 1024))
    if failed:
        print("No picture for: %s" % ", ".join(failed), file=sys.stderr)
        return 1
    print("Now run tools/deskhog index, so the index and the README list them.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
